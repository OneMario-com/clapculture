# ==========================================
# CLAPCULTURE ENVIRONMENT VARIABLES
# ==========================================
# Server variables are inlined at build time (see apps/web/next.config.ts),
# so set them before running the build/deploy.

# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=clapculture_project_id
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DATABASE_ID=clapculture_db

# Storage Buckets
APPWRITE_STORAGE_BUCKET_MEDIA=media

# Admin login (no database involved, so login works even while Appwrite is paused)
ADMIN_EMAIL=admin@clapculture.com
ADMIN_PASSWORD=choose_a_long_unique_password

# JWT Authentication — a NEW random value of at least 32 characters, e.g. `openssl rand -hex 32`.
# Values that were ever committed to this repository are rejected.
JWT_SECRET=

# Upstash Redis (REST API; works on Cloudflare's edge runtime). Optional but strongly
# recommended: shared cache, atomic order numbers and rate limits across all edge
# instances. Without it the app falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Next.js Public Vars — use the live site URL in production (it is used for links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Gmail SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=clapculture.co@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME=CLAPCULTURE
SMTP_FROM_EMAIL=clapculture.co@gmail.com
ADMIN_NOTIFICATION_EMAIL=clapculture.co@gmail.com
